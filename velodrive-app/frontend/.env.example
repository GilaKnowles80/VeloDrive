# VeloDrive Frontend Environment Variables
# Copy this file to .env and fill in your values

# The frontend uses relative /api paths, which are proxied
# to the backend via vercel.json rewrites in production.
# No VITE_ variables are required unless you want to override
# the API base URL for a custom backend.

# VITE_API_URL=https://api.gctravelandtour.com/api