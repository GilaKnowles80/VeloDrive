# Server
PORT=5000
NODE_ENV=development
# Canonical production deployment; the frontend rewrites /api/* to the backend URL.
FRONTEND_URL=https://frontend-2o4j.vercel.app
BACKEND_URL=https://velo-drive-green.vercel.app
# Local development:
# FRONTEND_URL=http://localhost:3000
# BACKEND_URL=http://localhost:5000

# Database - Neon PostgreSQL (Vercel's Neon integration provides NEON_POSTGRES_URL)
# Use DATABASE_URL for local/manual deployments; otherwise set DB_* for local PostgreSQL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=velodrive
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Auth (REQUIRED) - generate strong random secrets; never commit real values
# Example (Node): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Encryption (REQUIRED where used) - 32+ random chars recommended
ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_STRONG_RANDOM_KEY

# GDPR / Data retention
DATA_RETENTION_DAYS=2555

# Admin seed (required for npm run seed) - set locally or in your secret manager only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Account

# Platform fees (Philippines Peso)
PLATFORM_MEMBERSHIP_FEE=2500
SERVICE_CHARGE_FLAT_FEE=250

# PayPal - obtain from PayPal Developer Dashboard; keep secrets out of git
PAYPAL_CLIENT_ID=CHANGE_ME_PAYPAL_CLIENT_ID
PAYPAL_SECRET_KEY=CHANGE_ME_PAYPAL_SECRET_KEY
# Keep sandbox for development. Use live credentials and a matching live webhook ID only for production.
PAYPAL_MODE=sandbox
PAYPAL_ADMIN_EMAIL=gctravelandtours2021@gmail.com
PAYPAL_MEMBERSHIP_PLAN_ID=CHANGE_ME_PAYPAL_PLAN_ID
# Set to true only after PayPal confirms platform-fee/marketplace approval for this live account.
PAYPAL_PLATFORM_FEES_ENABLED=false

# PayPal Webhook - use the webhook ID from the same PayPal environment as PAYPAL_MODE
PAYPAL_WEBHOOK_ID=CHANGE_ME_PAYPAL_WEBHOOK_ID

# PayPal Partner Attribution ID (BN Code) - optional.
# Set only after PayPal approves your partner application and issues a BN code.
# Leave blank if you do not have one; the Partner-Attribution header is then omitted.
# PAYPAL_BN_CODE=CHANGE_ME_PAYPAL_BN_CODE

# Admin e-wallet / bank details for payouts & refunds (placeholders)
ADMIN_WALLET_NAME=VeloDrive Admin
ADMIN_WALLET_ACCOUNT=CHANGE_ME_ADMIN_WALLET_ACCOUNT
ADMIN_BANK_NAME=CHANGE_ME_BANK_NAME
ADMIN_BANK_ACCOUNT=CHANGE_ME_BANK_ACCOUNT

# Email / OTP Verification (Nodemailer SMTP). Use an app password; never commit it.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=CHANGE_ME_EMAIL_APP_PASSWORD
FROM_EMAIL=your-email@example.com

# Communication channels (phone call, SMS, email)
TWILIO_ACCOUNT_SID=CHANGE_ME_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=CHANGE_ME_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+10000000000
SENDGRID_API_KEY=CHANGE_ME_SENDGRID_API_KEY

# AWS S3 (private bucket for production uploads on Vercel; never enable public access)
# IAM needs PutObject, GetObject, and multipart-upload actions for objects under
# private/* and media/*; keep bucket public access blocked.
S3_BUCKET_NAME=vehicle-portfolio-uploader
S3_REGION=ap-southeast-2
S3_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_ACCESS_KEY

# ... existing vars above ...
# Email OTP - preferred: Resend (reliable on Vercel). Fallback: SMTP (Gmail requires App Password).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# FROM_EMAIL=VeloDrive <noreply@yourdomain.com>
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=YOUR_GMAIL_APP_PASSWORD_16_CHARS

# Observability/resilience (optional)
# SENTRY_DSN=https://...@sentry.io/...
# EMAIL_TIMEOUT_MS=15000
# PAYPAL_TIMEOUT_MS=20000
# EXPOSE_DEV_OTP=false
